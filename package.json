{
  "name": "repolens",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p .railway/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @repolens/web test:e2e",
    "db:migrate": "pnpm --filter @repolens/database migrate",
    "db:generate": "pnpm --filter @repolens/database generate",
    "seed:demo": "pnpm --filter @repolens/analyzer seed:demo"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "railway": "3.11.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
