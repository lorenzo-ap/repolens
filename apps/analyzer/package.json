{
  "name": "@repolens/analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/seed-demo.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@repolens/analysis": "workspace:*",
    "@repolens/database": "workspace:*",
    "@repolens/shared": "workspace:*",
    "@yarnpkg/lockfile": "1.1.0",
    "drizzle-orm": "0.45.2",
    "pg-boss": "12.31.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "semver": "7.8.5",
    "ts-morph": "28.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@repolens/config": "workspace:*",
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
