# --- shared ---
DATABASE_URL=postgres://repolens:repolens@localhost:5432/repolens
# Used by the test suites (must be a separate database)
TEST_DATABASE_URL=postgres://repolens:repolens@localhost:5432/repolens_test
NODE_ENV=development
LOG_LEVEL=info

# --- api ---
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# 32 random bytes, hex encoded. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=repolens_session
# GitHub OAuth app. Optional: the app runs in demo-only mode without it.
# Homepage URL: $WEB_ORIGIN   Callback URL: $WEB_ORIGIN/api/v1/auth/github/callback
# The callback is on the web origin and proxied to the API, so sessions stay first-party.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set to true behind a reverse proxy so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false
# Optional error reporting. Unset means no SDK is initialised and nothing is sent.
# The web app reads the same variable name for its server-side errors.
SENTRY_DSN=
# Per-user analysis quotas. The rate limiter bounds requests; these bound the work behind them.
# Analyses queued or running at once, per user:
MAX_CONCURRENT_ANALYSES=2
# Analyses started per user in any rolling 24 hours:
MAX_ANALYSES_PER_DAY=25

# --- web ---
# Where the Next.js server proxies /api/v1/* (read at build time for `next build`).
API_INTERNAL_URL=http://localhost:4000

# --- analyzer ---
ANALYZER_CONCURRENCY=1
# Directory for temporary clones (defaults to the OS temp dir)
ANALYZER_WORKDIR=
# Set to false to skip npm advisory lookups (offline environments)
ANALYZER_NETWORK=true

# --- demo seed (pnpm seed:demo) ---
DEMO_REPO_OWNER=honojs
DEMO_REPO_NAME=hono
DEMO_REPO_BRANCH=main
DEMO_REPO_DESCRIPTION=Web framework built on Web Standards
# Tags, branches or commit SHAs, oldest first
DEMO_COMMITS=v4.4.0,v4.8.0,v4.12.0,v4.13.7

# --- e2e ---
# Use a pre-installed Chromium instead of downloading one
PW_CHROMIUM_PATH=
