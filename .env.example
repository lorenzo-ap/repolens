# --- shared ---
DATABASE_URL=postgres://repolens:repolens@localhost:5432/repolens
NODE_ENV=development
LOG_LEVEL=info

# --- api ---
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# 32 random bytes, hex encoded. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Same value in web and api. Generate with: openssl rand -hex 32
SESSION_COOKIE_NAME=repolens_session
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: a token used to raise GitHub rate limits for public demo seeding.
GITHUB_SEED_TOKEN=

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# --- analyzer ---
ANALYZER_CONCURRENCY=1
ANALYZER_WORKDIR=
# Demo seed
DEMO_REPO_URL=https://github.com/vercel/swr.git
DEMO_REPO_OWNER=vercel
DEMO_REPO_NAME=swr
